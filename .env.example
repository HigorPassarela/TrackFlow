# Copie para .env e ajuste. O .env nunca é commitado.
# Os valores abaixo servem só para o ambiente local (docker/compose.yaml usa os mesmos como padrão).
# Uso: docker compose --env-file .env -f docker/compose.yaml up -d

# Banco (PostgreSQL)
TRACKFLOW_DB_URL=jdbc:postgresql://localhost:5432/trackflow
TRACKFLOW_DB_USER=trackflow
TRACKFLOW_DB_PASSWORD=trackflow

# Broker (RabbitMQ)
TRACKFLOW_RABBIT_HOST=localhost
TRACKFLOW_RABBIT_USER=trackflow
TRACKFLOW_RABBIT_PASSWORD=trackflow

# Storage compatível com S3 (SeaweedFS no local)
TRACKFLOW_STORAGE_ENDPOINT=http://localhost:8333
TRACKFLOW_STORAGE_REGION=us-east-1
TRACKFLOW_STORAGE_BUCKET=trackflow
TRACKFLOW_STORAGE_ACCESS_KEY=trackflow
TRACKFLOW_STORAGE_SECRET_KEY=trackflow

# Login social (OAuth2). Crie os apps conforme o README; callback local:
# http://localhost:8080/login/oauth2/code/{github|google}
TRACKFLOW_GITHUB_CLIENT_ID=your-github-client-id
TRACKFLOW_GITHUB_CLIENT_SECRET=your-github-client-secret
TRACKFLOW_GOOGLE_CLIENT_ID=your-google-client-id
TRACKFLOW_GOOGLE_CLIENT_SECRET=your-google-client-secret
