# Goes in the repository root (tarefa 1.3). Lombok is allowed only on JPA entities, and only
# @Getter, @NoArgsConstructor and @Builder. These flags turn the rest into compile errors.
config.stopBubbling = true
lombok.addLombokGeneratedAnnotation = true
lombok.data.flagUsage = error
lombok.value.flagUsage = error
lombok.setter.flagUsage = error
lombok.equalsAndHashCode.flagUsage = error
lombok.toString.flagUsage = error
