# Lombok is allowed only on JPA entities, and only @Getter, @NoArgsConstructor and @Builder.
# These flags turn the rest into compile errors. Never relax them to make the build pass.
config.stopBubbling = true
lombok.addLombokGeneratedAnnotation = true
lombok.data.flagUsage = error
lombok.value.flagUsage = error
lombok.setter.flagUsage = error
lombok.equalsAndHashCode.flagUsage = error
lombok.toString.flagUsage = error
